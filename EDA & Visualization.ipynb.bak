       "Name: town, Length: 9994, dtype: str"
      ]
     },
     "execution_count": 18,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    " df[\"operator\"].fillna(\"(Unknown Operator)\",inplace=True)\n",
    " df[\"state\"].fillna(\"Not_Applicable\",inplace=True)\n",
    " df[\"postcode\"].fillna(\"Unknown\",inplace=True)\n",
    " df[\"town\"].fillna(\"Unknown\",inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "49ceadf4-3977-4640-b4ed-64fc6659cccb",
   "metadata": {},
   "source": [
    "## Check and Remove Duplicates"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f188bc2c-ba57-4cdb-b217-a03d5a836433",
   "metadata": {},
   "source": [
    "Each id should have unique.Ensure no duplicates id are present."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "1d5e1dfd-4924-40a2-9471-9bb6b041353b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of duplicate:0\n"
     ]
    }
   ],
   "source": [
    " duplicate_count = df.duplicated(subset=[\"id\"]).sum()\n",
    " print(f\"Number of duplicate:{duplicate_count}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cc4e381a-2ffa-40d8-af20-46d19e8d9d00",
   "metadata": {},
   "source": [
    "There is no duplicates values present in our dataset"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "11359b0f-8c86-4690-859f-f7fc35bfff91",
   "metadata": {},
   "source": [
    "## Correcting data types "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bf524c5b-afb3-43d4-988b-28505d0fa6e3",
   "metadata": {},
   "source": [
    "Verify dates and categorical fields have appropriate formats."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "96801d11-b622-4f93-bf70-f741739c94b1",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Convert date_added columns to datetime\n",
    " df[\"date_added\"] = pd.to_datetime(df[\"date_added\"],errors = \"coerce\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "b2eb0e82-3558-4f31-a7c3-5d49e4772d54",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "id                               int64\n",
      "title                              str\n",
      "address                            str\n",
      "town                               str\n",
      "state                              str\n",
      "postcode                           str\n",
      "country                            str\n",
      "lat                            float64\n",
      "lon                            float64\n",
      "operator                           str\n",
      "status                             str\n",
      "num_connectors                   int64\n",
      "connector_types                 object\n",
      "date_added         datetime64[us, UTC]\n",
      "dtype: object\n"
     ]
    }
   ],
   "source": [
    " # Confirm Changes\n",
    " print(df.dtypes)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "10101348-7dd5-4491-aed9-1bbf342537fa",
   "metadata": {},
   "source": [
    "## Create derived columns "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "face9e0c-11d7-4c09-9929-c0de197f6fb5",
   "metadata": {},
   "source": [
    "Extract componenets from datetime for better analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "a66f8368-d12e-4a71-b48f-b14442817ff5",
   "metadata": {},
   "outputs": [],
   "source": [
    " df[\"added_month\"] = df[\"date_added\"].dt.month_name()\n",
    " df[\"added_day\"] = df[\"date_added\"].dt.day\n",
    " df[\"added_hour\"] = df[\"date_added\"].dt.hour\n",
    " df[\"added_minute\"] = df[\"date_added\"].dt.minute\n",
    " df[\"day_of_week\"] = df[\"date_added\"].dt.day_name()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "bd067d85-4095-4047-a88c-6ee30bf00c8f",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Calculate station age(if you have current date)\n",
    " current_date = pd.Timestamp.now().tz_localize(None)\n",
    " df[\"date_added\"] = pd.to_datetime(df[\"date_added\"]).dt.tz_localize(None)\n",
    " df[\"days_since_added\"] = (current_date - df[\"date_added\"]).dt.days\n",
    " "
   ]
  },
