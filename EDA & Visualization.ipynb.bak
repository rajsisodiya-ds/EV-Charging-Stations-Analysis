   "source": [
    "plt.figure(figsize=(10, 6))\n",
    "sns.boxplot(data=df, x='status', y='num_connectors', palette='Set2')\n",
    "plt.title('Number of Connectors by Station Status', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Status')\n",
