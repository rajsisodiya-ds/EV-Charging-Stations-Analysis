  {
   "cell_type": "markdown",
   "id": "50b24f9a-ceaf-438c-a4c3-77bb9715abab",
   "metadata": {},
   "source": [
    "## Filter and Aggregate"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cc5a92ed-2d2e-4b1b-93f9-7f5f5b19019d",
   "metadata": {},
   "source": [
    "This will help with:\n",
    "\n",
    "✔ Fast-charging analysis\n",
    "\n",
    "✔ Market share insights\n",
    "\n",
    "✔ Find the best EV-supported cities\n",
    "\n",
    "✔ Identify high-capacity stations\n",
    "\n",
    "✔ Evaluate countries’ EV readiness\n",
    "\n",
    "✔ Compare operator infrastructure quality\n",
    "\n",
    "✔ Support EV policy, planning, and investment decisions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "94345cd4-23f8-4265-9325-f31cda4a702e",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Fast chargers\n",
    " fast_mask = df[\"connector_types\"].str.contains(\"CCS|NACS|GB-?T DC|CHAdeMO\",case = False,na = False)\n",
    " fast_chargers =  df[fast_mask]  \n",
    "\n",
    " # Slow/ Ac chargers(Type1,Type2,CEE,Schuko)\n",
    " slow_mask = df[\"connector_types\"].str.contains(\"Type 1|Type 2|CEE|Schuko\",case = False,na = False)\n",
    " slow_chargers = df[slow_mask]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "ab5383a8-1370-4f14-a60a-c1af3d36fdd0",
   "metadata": {},
   "outputs": [],
   "source": [
    " # identifying large charging hubs\n",
    " large_sites = df[df[\"num_connectors\"] > 2]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "5166b168-b381-4185-acb1-913ab7faa600",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Stations per Operator\n",
    " stations_by_operator = ( df.groupby(\"operator\", as_index=False)[\"id\"].count() .rename(columns={\"id\": \"total_stations\"})\n",
    "                       .sort_values(\"total_stations\", ascending=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "de42fb56-30d5-474a-81ac-c385ed6f61dd",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Stations per Country\n",
    " stations_by_country = (df.groupby(\"country\", as_index=False)[\"id\"].count().rename(columns={\"id\": \"total_stations\"})\n",
    "                      .sort_values(\"total_stations\", ascending=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "f08b554f-d8be-4a3e-91ef-447ff200fecc",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Average Connectors Per Operator\n",
    " avg_connectors_by_operator = (df.groupby(\"operator\", as_index=False)[\"num_connectors\"].mean()\n",
    "                             .rename(columns={\"num_connectors\": \"avg_connectors\"}).sort_values(\"avg_connectors\", ascending=False))"
   ]
  },
