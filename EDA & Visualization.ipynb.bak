   "id": "057e30b1-4657-4cf2-a040-7fae85278559",
   "metadata": {},
   "outputs": [],
   "source": [
    " df.dropna(subset=[\"address\"],inplace=True)\n",
    " df.dropna(subset=[\"connector_types\"],inplace=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "38f7ff64-f841-431d-ab8d-96fd8e73965a",
   "metadata": {},
   "source": [
    "Cleanly remove “Unknown” while keeping valid connector types perfect Aggregations and Visulaization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "f2b2ed3e-d1aa-4151-9534-1488b5bb566d",
   "metadata": {},
   "outputs": [],
   "source": [
    "df['connector_types'] = (df['connector_types']\n",
    "    .str.split('|')                      # split into list\n",
    "    .apply(lambda x: [i for i in x if i != 'Unknown'])  # remove Unknown\n",
    "    .str.join('|') )                      # join back"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f7a025f2-e0d6-4441-9d37-d3bbb81d4230",
   "metadata": {},
