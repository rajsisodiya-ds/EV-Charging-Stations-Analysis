     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure(figsize=(12, 8))\n",
    "top_operators = df['operator'].value_counts().head(10)\n",
    "sns.barplot(y=top_operators.values, x=top_operators.index)\n",
